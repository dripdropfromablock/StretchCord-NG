<Window x:Class="StretchCordNG.UI.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a window"
        Width="600"
        Height="500"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B.Bg}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Pick the game window you want to stream"
                   Foreground="{StaticResource B.Text}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Padding="12,8"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter by title or process name"/>

            <Button Grid.Column="1"
                    Content="↻ Refresh"
                    Style="{StaticResource Btn.Ghost}"
                    Margin="8,0,0,0"
                    Click="BtnRefresh_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource B.Surface}"
                BorderBrush="{StaticResource B.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="4">
            <ListBox x:Name="WindowList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource B.Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="WindowList_SelectionChanged"
                     MouseDoubleClick="WindowList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Icon}"
                                   Width="18"
                                   Height="18"
                                   Margin="0,0,11,0"
                                   VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{StaticResource B.Text}"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Foreground="{StaticResource B.TextFaint}"
                                           FontSize="11"
                                           Margin="0,2,0,0">
                                    <Run Text="{Binding ProcessName, Mode=OneWay}"/>
                                    <Run Text=" · PID "/>
                                    <Run Text="{Binding ProcessId, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding SizeLabel}"
                                       Foreground="{StaticResource B.TextFaint}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="12,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectionLabel"
                       Text="Double-click a window, or select one and press Enter"
                       Foreground="{StaticResource B.TextFaint}"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0"/>

            <Button Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource Btn.Ghost}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="2"
                    x:Name="BtnSelect"
                    Content="Capture this window"
                    Style="{StaticResource Btn.Primary}"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="BtnSelect_Click"/>
        </Grid>
    </Grid>
</Window>
